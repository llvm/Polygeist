diff --git a/scripts/correctness/polygeist_build.sh b/scripts/correctness/polygeist_build.sh
--- a/scripts/correctness/polygeist_build.sh
+++ b/scripts/correctness/polygeist_build.sh
@@ -795,6 +795,15 @@ elif [ "$TARGET" = "host-cuda" ]; then
            -lcudnn -lcublasLt -lcublas -lcufft -lcusparse -lcusolver \
            -lcudart -lm -lpthread -ldl \
            -Wl,-rpath,/usr/local/cuda/targets/x86_64-linux/lib:/usr/lib/x86_64-linux-gnu"
+  if [ -n "${POLYGEIST_CUTENSOR_ROOT:-}" ]; then
