      %1715 = arith.addf %out, %1714 : f64
      linalg.yield %1715 : f64
    } -> tensor<?x?x?x?xf64>
    %1710 = polygeist.submapInverse(%1466, %1709, %c2, %c4, %c4, %c4) {map = #map4} : (tensor<?xf64>, tensor<?x?x?x?xf64>, index, index, index, index) -> tensor<?xf64>
    %1711 = bufferization.to_memref %1710 : memref<?xf64>
    memref.copy %1711, %arg12 : memref<?xf64> to memref<?xf64>
    return
  }
}
