diff --git a/clang/lib/Sema/SemaExpr.cpp b/clang/lib/Sema/SemaExpr.cpp
index 92496b03e..f0a768441 100644
--- a/clang/lib/Sema/SemaExpr.cpp
+++ b/clang/lib/Sema/SemaExpr.cpp
@@ -851,6 +851,24 @@ ExprResult Sema::UsualUnaryConversions(Expr *E) {
       E = ImpCastExprToType(E, PTy, CK_IntegralCast).get();
       return E;
     }
+    // Xilinx HLS (-fxlx-apint-promote): an arbitrary-precision integer no
+    // wider than int takes part in the integer promotions like a narrow
+    // builtin integer: it becomes int, or unsigned int for an unsigned one
+    // exactly as wide as int. Re-implemented from hls-llvm-project ee930469
+    // SemaExpr.cpp:704 and ASTContext.cpp:5553 (isPromotableIntegerOrAPIntType)
+    // and :5575 (getPromotedIntegerType).
+    if (getLangOpts().XlxAPIntPromote) {
+      if (const auto *BIT = Ty->getAs<BitIntType>()) {
+        uint64_t IntWidth = Context.getIntWidth(Context.IntTy);
+        if (BIT->getNumBits() <= IntWidth) {
+          QualType PT = (BIT->isUnsigned() && BIT->getNumBits() == IntWidth)
+                            ? Context.UnsignedIntTy
+                            : Context.IntTy;
+          E = ImpCastExprToType(E, PT, CK_IntegralCast).get();
+          return E;
+        }
+      }
+    }
     if (Context.isPromotableIntegerType(Ty)) {
       QualType PT = Context.getPromotedIntegerType(Ty);
       E = ImpCastExprToType(E, PT, CK_IntegralCast).get();
diff --git a/clang/lib/Sema/SemaType.cpp b/clang/lib/Sema/SemaType.cpp
index d13a5564e..a63bfa37a 100644
--- a/clang/lib/Sema/SemaType.cpp
+++ b/clang/lib/Sema/SemaType.cpp
@@ -2361,8 +2361,25 @@ QualType Sema::BuildBitIntType(bool IsUnsigned, Expr *BitWidth,
   if (ICE.isInvalid())
     return QualType();
 
+  // Xilinx HLS (-fxlx-bitwidth): every width from 1 up is valid, for both
+  // signednesses, so a width below 1 gets its own message instead of the
+  // _BitInt one (which says 2 for signed). The Xilinx front end rejects
+  // widths above 8191 (hls-llvm-project ee930469 Type.h:1545 and :3131,
+  // APIntType::isSizeTooLarge, used at SemaType.cpp:2320); whether Vitis
+  // 2025.1 has the same ceiling is unconfirmed, so that is a warning.
+  // Custom diagnostic IDs keep this private patch out of the diagnostic
+  // tables (no rebuild of every clang library that includes them).
+  if (getLangOpts().XlxBitWidth && (Bits.isNegative() || Bits.isZero())) {
+    Diag(Loc, Diags.getCustomDiagID(DiagnosticsEngine::Error,
+                                    "bit width must be at least 1"));
+    return QualType();
+  }
+  const uint64_t XlxMaxBitWidth = 8191;
+
   size_t NumBits = Bits.getZExtValue();
-  if (!IsUnsigned && NumBits < 2) {
+  // Xilinx HLS: ap_int<1> is a signed 1-bit integer.
+  bool AllowSigned1 = getLangOpts().XlxBitWidth && NumBits == 1;
+  if (!IsUnsigned && NumBits < 2 && !AllowSigned1) {
     Diag(Loc, diag::err_bit_int_bad_size) << 0;
     return QualType();
   }
@@ -2379,6 +2396,12 @@ QualType Sema::BuildBitIntType(bool IsUnsigned, Expr *BitWidth,
     return QualType();
   }
 
+  if (getLangOpts().XlxBitWidth && NumBits > XlxMaxBitWidth)
+    Diag(Loc, Diags.getCustomDiagID(DiagnosticsEngine::Warning,
+                                    "bit width %0 exceeds %1, the largest "
+                                    "the Xilinx HLS front end accepts"))
+        << static_cast<uint64_t>(NumBits) << XlxMaxBitWidth;
+
   return Context.getBitIntType(IsUnsigned, NumBits);
 }
 
@@ -8164,6 +8187,44 @@ void Sema::adjustMemberFunctionCC(QualType &T, bool IsStatic, bool IsCtorOrDtor,
   T = Context.getAdjustedType(T, Wrapped);
 }
 
+/// HandleXlxBitWidthAttr - the Xilinx HLS __attribute__((bitwidth(N))) on a
+/// builtin integer type (the Vitis HLS headers' ssdm_int, ap_common.h).
+/// Re-implemented from hls-llvm-project ee930469 SemaType.cpp:6867
+/// (HandleBitWidthAttr) and :2295 (BuildAPIntType): the type becomes
+/// _BitInt(N) / unsigned _BitInt(N) with the signedness of the base type; a
+/// template-dependent N yields a DependentBitIntType.
+static void HandleXlxBitWidthAttr(QualType &CurType, ParsedAttr &Attr,
+                                  Sema &S) {
+  if (!S.getLangOpts().XlxBitWidth) {
+    // Same diagnostic as before the attribute was known.
+    S.Diag(Attr.getLoc(), diag::warn_unknown_attribute_ignored)
+        << Attr << Attr.getRange();
+    Attr.setInvalid();
+    return;
+  }
+  if (Attr.getNumArgs() != 1) {
+    S.Diag(Attr.getLoc(), diag::err_attribute_wrong_number_arguments)
+        << Attr << 1;
+    Attr.setInvalid();
+    return;
+  }
+  Qualifiers Quals = CurType.getQualifiers();
+  QualType Base = CurType.getCanonicalType().getUnqualifiedType();
+  if (!Base->isBuiltinType() || !Base->isIntegerType()) {
+    S.Diag(Attr.getLoc(), diag::err_attribute_wrong_decl_type_str)
+        << Attr << Attr.isRegularKeywordAttribute() << "builtin integer types";
+    Attr.setInvalid();
+    return;
+  }
+  QualType T = S.BuildBitIntType(!Base->isSignedIntegerType(),
+                                 Attr.getArgAsExpr(0), Attr.getLoc());
+  if (T.isNull()) {
+    Attr.setInvalid();
+    return;
+  }
+  CurType = S.Context.getQualifiedType(T, Quals);
+}
+
 /// HandleVectorSizeAttribute - this attribute is only applicable to integral
 /// and float scalars, although arrays, pointers, and function return values are
 /// allowed in conjunction with this construct. Aggregates with this attribute
@@ -8700,6 +8761,11 @@ static void processTypeAttrs(TypeProcessingState &state, QualType &type,
         distributeObjCPointerTypeAttr(state, attr, type);
       attr.setUsedAsTypeAttr();
       break;
+    case ParsedAttr::AT_XlxBitWidth:
+      if (!attr.isInvalid())
+        HandleXlxBitWidthAttr(type, attr, state.getSema());
+      attr.setUsedAsTypeAttr();
+      break;
     case ParsedAttr::AT_VectorSize:
       HandleVectorSizeAttr(type, attr, state.getSema());
       attr.setUsedAsTypeAttr();
