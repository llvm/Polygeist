diff --git a/clang/test/Sema/xlx-bitwidth.c b/clang/test/Sema/xlx-bitwidth.c
new file mode 100755
index 000000000..5c038b13b
--- /dev/null
+++ b/clang/test/Sema/xlx-bitwidth.c
@@ -0,0 +1,54 @@
+// Xilinx HLS bitwidth(N) attribute (-fxlx-bitwidth): the type becomes _BitInt(N).
+// RUN: %clang_cc1 -fsyntax-only -fxlx-bitwidth -verify=on %s
+// RUN: %clang_cc1 -fsyntax-only -fxlx-bitwidth -fxlx-apint-promote -verify=on -DPROMOTE %s
+// RUN: %clang_cc1 -fsyntax-only -verify=off -DOFF %s
+
+typedef int __attribute__((bitwidth(7))) i7;        // off-warning {{unknown attribute 'bitwidth' ignored}}
+typedef unsigned __attribute__((bitwidth(12))) u12; // off-warning {{unknown attribute 'bitwidth' ignored}}
+
+#ifdef OFF
+_Static_assert(__builtin_types_compatible_p(i7, int), "");
+_Static_assert(__builtin_types_compatible_p(u12, unsigned), "");
+#else
+_Static_assert(__builtin_types_compatible_p(i7, _BitInt(7)), "");
+_Static_assert(__builtin_types_compatible_p(u12, unsigned _BitInt(12)), "");
+
+// Declarator position, as in the Vitis ssdm_int (ap_common.h).
+int x33 __attribute__((bitwidth(33)));
+_Static_assert(__builtin_types_compatible_p(__typeof__(x33), _BitInt(33)), "");
+const unsigned cu5 __attribute__((bitwidth(5))) = 31;
+_Static_assert(__builtin_types_compatible_p(__typeof__(cu5), const unsigned _BitInt(5)), "");
+
+// Signed width 1 (ap_int<1>) is allowed under the flag.
+typedef int __attribute__((bitwidth(1))) i1;
+_Static_assert((i1)1 == -1, "");
+
+// Bad uses.
+float f __attribute__((bitwidth(3)));   // on-error {{'bitwidth' attribute only applies to builtin integer types}}
+int w __attribute__((bitwidth(1, 2)));  // on-error {{'bitwidth' attribute takes one argument}}
+int z __attribute__((bitwidth(0)));     // on-error {{bit width must be at least 1}}
+unsigned uz __attribute__((bitwidth(0))); // on-error {{bit width must be at least 1}}
+int neg __attribute__((bitwidth(-3)));  // on-error {{bit width must be at least 1}}
+// Vitis' AP_INT_MAX_W (x86-64 _BitInt has no smaller limit).
+int max __attribute__((bitwidth(4096)));
+int xmax __attribute__((bitwidth(8191)));
+// Above the open-source Xilinx front end's ceiling: accepted with a warning.
+int big __attribute__((bitwidth(9000))); // on-warning {{bit width 9000 exceeds 8191, the largest the Xilinx HLS front end accepts}}
+
+i7 a;
+u12 b;
+unsigned __attribute__((bitwidth(32))) u32v;
+int __attribute__((bitwidth(33))) s33;
+#ifdef PROMOTE
+// Re-implemented Vitis promotion: no wider than int -> int (unsigned int for
+// an unsigned 32-bit one); wider types do not promote.
+_Static_assert(__builtin_types_compatible_p(__typeof__(a + a), int), "");
+_Static_assert(__builtin_types_compatible_p(__typeof__(b << 1), int), "");
+_Static_assert(__builtin_types_compatible_p(__typeof__(-u32v), unsigned int), "");
+_Static_assert(__builtin_types_compatible_p(__typeof__(s33 + s33), _BitInt(33)), "");
+_Static_assert(__builtin_types_compatible_p(__typeof__(~a), int), "");
+#else
+_Static_assert(__builtin_types_compatible_p(__typeof__(a + a), _BitInt(7)), "");
+_Static_assert(__builtin_types_compatible_p(__typeof__(b << 1), unsigned _BitInt(12)), "");
+#endif
+#endif
diff --git a/clang/test/SemaCXX/xlx-bitwidth-template.cpp b/clang/test/SemaCXX/xlx-bitwidth-template.cpp
new file mode 100755
index 000000000..d80b431a4
--- /dev/null
+++ b/clang/test/SemaCXX/xlx-bitwidth-template.cpp
@@ -0,0 +1,50 @@
+// Xilinx HLS bitwidth(N) with a template-dependent N. The declarations are
+// written for this test from the attribute's behaviour; none is taken from the
+// Vitis-installed headers.
+// RUN: %clang_cc1 -std=gnu++14 -fsyntax-only -fxlx-bitwidth -verify %s
+// expected-no-diagnostics
+
+template <int N> struct SField { int v __attribute__((bitwidth(N))); };
+template <int N> struct UField { unsigned v __attribute__((bitwidth(N))); };
+template <int N> struct UTraits {
+  typedef unsigned __attribute__((bitwidth(N))) type;
+};
+template <int N> struct STraits {
+  typedef int __attribute__((bitwidth(N))) type;
+};
+
+template <class A, class B> struct same { static const bool value = false; };
+template <class A> struct same<A, A> { static const bool value = true; };
+
+static_assert(same<decltype(SField<17>::v), _BitInt(17)>::value, "");
+static_assert(same<decltype(SField<1>::v), _BitInt(1)>::value, "");
+static_assert(same<decltype(UField<256>::v), unsigned _BitInt(256)>::value, "");
+static_assert(same<UTraits<4096>::type, unsigned _BitInt(4096)>::value, "");
+static_assert(same<STraits<5>::type, _BitInt(5)>::value, "");
+
+// Deduction of N from the bit-precise type.
+template <int N> constexpr int width(_BitInt(N)) { return N; }
+template <int N> constexpr int uwidth(unsigned _BitInt(N)) { return N; }
+static_assert(width(SField<23>().v) == 23, "");
+static_assert(uwidth(UField<70>().v) == 70, "");
+
+// A parameter with a dependent width, in constant evaluation: the argument
+// is converted to N bits.
+template <int N> constexpr long long narrow(int x __attribute__((bitwidth(N)))) {
+  return x;
+}
+static_assert(narrow<5>(31) == -1, "");
+template <int N>
+constexpr unsigned long long unarrow(unsigned x __attribute__((bitwidth(N)))) {
+  return x;
+}
+static_assert(unarrow<9>(512) == 0, "");
+
+// A dependent-width local inside a function template.
+template <int W> constexpr unsigned long long mask(int lo, int hi) {
+  unsigned int m __attribute__((bitwidth(W))) = (unsigned _BitInt(W))-1;
+  m >>= (int)(W - (hi - lo + 1));
+  return (unsigned long long)m;
+}
+static_assert(mask<12>(0, 3) == 0xF, "");
+static_assert(mask<12>(2, 11) == 0x3FF, "");
