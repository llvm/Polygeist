# HLSFactory chstone/gsm (top: Gsm_LPC_Analysis), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/chstone/gsm" && cgeist add.c lpc.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
# The hls-est harness's cgeist command for this design, plus the pragma report (which does
# not change the MLIR).
# PRAGMA-NOT: Stack dump
# PRAGMA-NOT: {{^[^/[:space:]][^[:space:]]*}}: remark:
# MLIR-DAG: memref.global {{.*}}@bitoff : memref<256xi8>
# MLIR-LABEL: func.func @Gsm_LPC_Analysis(
# MLIR-SAME: %arg0: memref<160xi16>, %arg1: memref<8xi16>)
# MLIR: = memref.alloca({{.*}}: memref<9xi64>{{$}}
# REQUIRES: vitis-autopilot, xlx-bitwidth
