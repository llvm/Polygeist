# HLSFactory machsuite/aes_table (top: aes256_encrypt_ecb), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/machsuite/aes_table" && cgeist aes_table.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
