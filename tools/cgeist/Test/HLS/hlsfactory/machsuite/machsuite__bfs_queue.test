# HLSFactory machsuite/bfs_queue (top: bfs), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/machsuite/bfs_queue" && cgeist bfs.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
# The hls-est harness's cgeist command for this design, plus the pragma report (which does
# not change the MLIR).
# PRAGMA-NOT: Stack dump
# PRAGMA-NOT: {{^[^/[:space:]][^[:space:]]*}}: remark:
# MLIR-LABEL: func.func @bfs(
# MLIR-SAME: %arg0: memref<256x2xi64>, %arg1: memref<4096xi64>, %arg2: i64, %arg3: memref<256xi8>, %arg4: memref<10xi64>)
# MLIR: = memref.alloca({{.*}}: memref<256xi64>{{$}}
