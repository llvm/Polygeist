# HLSFactory machsuite/md_grid (top: md), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/machsuite/md_grid" && cgeist md.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
# The hls-est harness's cgeist command for this design, plus the pragma report (which does
# not change the MLIR).
# PRAGMA-NOT: Stack dump
# PRAGMA-NOT: {{^[^/[:space:]][^[:space:]]*}}: remark:
# MLIR-LABEL: func.func @md(
# MLIR-SAME: %arg0: memref<4x4x4xi32>, %arg1: memref<4x4x4x10x3xf64>, %arg2: memref<4x4x4x10x3xf64>)
# REQUIRES: vitis-autopilot, xlx-bitwidth
