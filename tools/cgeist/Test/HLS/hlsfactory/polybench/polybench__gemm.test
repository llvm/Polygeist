# HLSFactory polybench/gemm (top: gemm), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/polybench/gemm" && cgeist src/gemm.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -I src -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
# The hls-est harness's cgeist command for this design, plus the pragma report (which does
# not change the MLIR).
# PRAGMA-NOT: Stack dump
# PRAGMA-NOT: {{^[^/[:space:]][^[:space:]]*}}: remark:
# MLIR-LABEL: func.func @gemm(
# MLIR-SAME: %arg0: f32, %arg1: f32, %arg2: memref<64x64xf32>, %arg3: memref<64x64xf32>, %arg4: memref<64x64xf32>, %arg5: memref<64x64xf32>)
# MLIR: = memref.alloca({{.*}}: memref<64x64xf32>{{$}}
# MLIR: = memref.alloca({{.*}}: memref<64x64xf32>{{$}}
# MLIR: = memref.alloca({{.*}}: memref<64x64xf32>{{$}}
# MLIR: = memref.alloca({{.*}}: memref<64x64xf32>{{$}}
# REQUIRES: vitis-autopilot, xlx-bitwidth
