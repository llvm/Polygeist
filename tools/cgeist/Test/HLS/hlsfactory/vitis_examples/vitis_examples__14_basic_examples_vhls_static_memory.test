# HLSFactory vitis_examples/14_basic_examples_vhls_static_memory (top: malloc_removed), generated by generate.py.
# Mode: full.
# RUN: cd "%S/../Inputs/vitis_examples/14_basic_examples_vhls_static_memory" && cgeist malloc_removed.c --function='*' -S --hls-annotate --raise-scf-to-affine --memref-fullrank %vitis_real_flags %resourcedir %vitis_frontend_c99 -I . -o /dev/null %hlsfactory_mlir --hls-pragma-report 2>&1 | FileCheck --check-prefix=PRAGMA --allow-empty %s && FileCheck --check-prefix=MLIR %s < %t.mlir
# The hls-est harness's cgeist command for this design, plus the pragma report (which does
# not change the MLIR).
# PRAGMA-NOT: Stack dump
# PRAGMA-NOT: {{^[^/[:space:]][^[:space:]]*}}: remark:
# MLIR-LABEL: func.func @malloc_removed(
# MLIR-SAME: %arg0: memref<32xi32>, %arg1: i32)
# MLIR: = memref.alloca({{.*}}: memref<64xi32>{{$}}
